# Copy to .env to override the Docker Compose defaults.

POSTGRES_DB=skillbharat
POSTGRES_USER=skillbharat
POSTGRES_PASSWORD=change-me

# REQUIRED outside local development: a long random string (32+ characters).
#   openssl rand -base64 48
JWT_SECRET=

# true = load demo accounts, employers, jobs and applications on first start. Use false in production.
SEED_DEMO_DATA=true

# Production: create the first Super Admin from these (used only when no admin exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origins allowed to call the API from a browser (only needed if the web app is on a different origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
