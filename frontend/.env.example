# Optional. By default the app calls the same origin under /api (Vite proxy in dev, nginx in Docker).
# VITE_API_BASE_URL=http://localhost:8080/api
# Where the Vite dev server forwards /api
# VITE_API_PROXY=http://localhost:8080
# Show one-click demo logins on the sign-in page (only useful with seeded demo data)
VITE_SHOW_DEMO_LOGINS=true
